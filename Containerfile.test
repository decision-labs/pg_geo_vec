ARG PG_MAJOR=17
FROM docker.io/postgres:${PG_MAJOR}

ARG PG_MAJOR=17

# Install build dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    pkg-config \
    libssl-dev \
    libreadline-dev \
    zlib1g-dev \
    curl \
    git \
    postgresql-server-dev-${PG_MAJOR} \
    postgresql-${PG_MAJOR}-postgis-3 \
    postgresql-${PG_MAJOR}-pgvector \
    clang \
    llvm \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies for test data loading
RUN pip3 install --break-system-packages pyarrow psycopg2-binary

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# Install cargo-pgrx
RUN cargo install cargo-pgrx --version 0.16.1 --locked

# Initialize pgrx with the system PostgreSQL
RUN cargo pgrx init --pg${PG_MAJOR}=/usr/bin/pg_config

# Build and install pgvectorscale (DiskANN) for the same PG major
RUN git clone --branch 0.9.0 --depth 1 https://github.com/timescale/pgvectorscale.git /tmp/pgvectorscale \
    && cd /tmp/pgvectorscale/pgvectorscale \
    && cargo pgrx install --release --no-default-features --features pg${PG_MAJOR} \
    && rm -rf /tmp/pgvectorscale

ENV PG_MAJOR=${PG_MAJOR}
WORKDIR /workspace
